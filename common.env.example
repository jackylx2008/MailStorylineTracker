# 复制为 common.env 后填写真实值；该本地文件不会被 Git 跟踪。
MAIL_IMAP_HOST=imap.126.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=your-account@126.com
MAIL_IMAP_PASSWORD=your-126-client-authorization-code
MAIL_IMAP_SUPPORT_EMAIL=support@example.invalid
MAIL_FOLDERS_JSON=["INBOX"]
MAIL_SINCE=2024-01-01
MAIL_BEFORE=
MAIL_MAX_MESSAGES_PER_FOLDER=500
MAIL_FILTER_SENDERS_JSON=[]
MAIL_FILTER_RECIPIENTS_JSON=[]
MAIL_FILTER_KEYWORDS_JSON=[]
MAIL_FILTER_MATCH_MODE=any

# 已经运行的 OpenAI 兼容服务。本项目不会启动或关闭该服务。
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_MODEL=local-model
AI_API_KEY=
AI_REMOTE_ENABLED=false

CLOUDSTATION_ROOT_WINDOWS=D:\CloudStation
CLOUDSTATION_ROOT_MACOS=~/SynologyDrive
CLOUDSTATION_ROOT_LINUX=~/CloudStation
